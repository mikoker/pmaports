4f533bb18e70fd8480275b3bec9f4262cc75ef92a3cfb617284781d53ade4edf70b78c4872d51bc0e48cb4ec8f2186f319df541bd12703ea6f881a9897688319  30-initramfs-firmware-xiaomi-sweet.files
f0ea0901fe80e3c555db69e963b9a9b5b135b50fce20b8465ed3c3356e5ec84d290ef268b46d37fe3d304e26b1b55e0184295dc3afdf615425345ca916484f44  socinfo-revision
