maintainer="Aelin <aelin@postmarketos.org>"
pkgname=firmware-xiaomi-sweet
pkgver=3
pkgrel=3
pkgdesc="Firmware for Xiaomi Redmi Note 10 Pro"
url="https://github.com/mikoker/firmware-xiaomi-sweet"
arch="aarch64"
license="proprietary"
# Proprietary ADSP runtime libraries contain text relocations.
options="!check !strip !archcheck !tracedeps textrels pmb:cross-native"
_commit="cd275dbb592b6e0c2520ecd73304396f8b3af690"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit/$pkgname-$_commit.tar.gz
	30-initramfs-$pkgname.files
	socinfo-revision
	aw882xx_pid_2032_acf.bin
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	find . -type f -exec install -Dm644 {} "$pkgdir"/{} \;

	# Model-specific dual-amplifier profiles (channels 0 and 1).
	install -Dm644 "$srcdir/aw882xx_pid_2032_acf.bin" \
		"$pkgdir/lib/firmware/aw882xx_pid_2032_acf.bin"

	# HexagonFS serves these paths instead of the physical sysfs/vendor paths.
	local hexagonfs="$pkgdir/usr/share/qcom/sm7150/Xiaomi/sweet"
	install -Dm644 "$srcdir/socinfo-revision" "$hexagonfs/socinfo/revision"
	install -Dm644 vendor/lib/rfsa/adsp/* -t "$hexagonfs/dsp/adsp"

	install -Dm644 "$srcdir/30-initramfs-$pkgname.files" -t \
		"$pkgdir"/usr/share/mkinitfs/files
}

sha512sums="
