# Co-Maintainer: David Wronek <david@mainlining.org>
maintainer="Danila Tikhonov <danila@jiaxyga.com>"
pkgname=alsa-ucm-conf-qcom-sm7150
pkgver=1.2.15.3_git20260513
pkgrel=7
pkgdesc="ALSA UCM configuration for SM7150 devices"
url="https://github.com/sm7150-mainline/alsa-ucm-conf"
arch="aarch64"
license="BSD-3-Clause"
provides="alsa-ucm-conf=0.${pkgver%_*}-r$pkgrel" # versioned provides need to be below default version
_commit="4821070589906c1d80c83210639591678c245369"
source="
	$pkgname-$_commit.tar.gz::https://github.com/sm7150-mainline/alsa-ucm-conf/archive/$_commit.tar.gz
	sweet.conf
	sweet-HiFi.conf
"
options="!check"
builddir="$srcdir/alsa-ucm-conf-$_commit"

package() {
	# install audio config files
	mkdir -p "$pkgdir"/usr/share/alsa
	cp -r ucm2 "$pkgdir"/usr/share/alsa/
	install -Dm644 "$srcdir/sweet.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/xiaomi-XiaomiRedmiNote10Pro.conf"
	install -Dm644 "$srcdir/sweet-HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/sweet/HiFi.conf"
}

sha512sums="
