+/* Notify only after the DSP reverse listener is initialized. This keeps
+ * systemd ordering tied to an RPC handshake instead of process creation.
+ * No libsystemd dependency is needed for the static daemon. */
+static int notify_listener_ready(void)
+{
+	const char *path = getenv("NOTIFY_SOCKET");
+	const char message[] = "READY=1\nSTATUS=FastRPC listener initialized";
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	size_t length;
+	ssize_t sent;
+	int socket_fd, saved_errno;
+
+	if (!path)
+		return 0;
+	length = strlen(path);
+	if (!length || length >= sizeof(address.sun_path) ||
+	    (path[0] != '/' && path[0] != '@'))
+		return -EINVAL;
+	memcpy(address.sun_path, path, length + 1);
+	if (path[0] == '@')
+		address.sun_path[0] = '\0';
+	socket_fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+	if (socket_fd < 0)
+		return -errno;
+	sent = sendto(socket_fd, message, sizeof(message) - 1, MSG_NOSIGNAL,
+		      (struct sockaddr *)&address,
+		      offsetof(struct sockaddr_un, sun_path) + length +
+		      (path[0] == '/'));
+	saved_errno = errno;
+	close(socket_fd);
+	if (sent < 0)
+		return -saved_errno;
+	return sent == sizeof(message) - 1 ? 0 : -EIO;
+}
