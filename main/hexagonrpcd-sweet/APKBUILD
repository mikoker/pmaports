# Local workaround tested on Xiaomi Redmi Note 10 Pro (sweet).
maintainer="mikoker <mikolaj.kolata@gmail.com>"
pkgname=hexagonrpcd-sweet
pkgver=0.4.0
pkgrel=6
pkgdesc="Static HexagonFS daemon workaround for Xiaomi sweet"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-3.0-or-later"
depends="hexagonrpcd firmware-xiaomi-sweet"
makedepends_host="linux-headers"
# Validation requires an actual ADSP and a full device boot.
options="!check !strip pmb:cross-native2"
source="
	hexagonrpcd-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
	hexagonrpcd-adsp-rootpd.conf
	hexagonrpcd-adsp-sensorspd.conf
	iio-sensor-proxy.conf
	hexagonrpcd-sweet-resume
	hexagonrpcd-sweet-resume.service
	listener-ready.patch
"
builddir="$srcdir/hexagonrpc-$pkgver"

build() {
	# Preserve the compiler/linking configuration verified on the phone.
	# Build the daemon and its RPC implementation into one static executable.
	${CC:-cc} --sysroot="${CBUILDROOT:-/}" -static -O2 -g -std=gnu11 -D_GNU_SOURCE \
		-Iinclude -Ihexagonrpcd \
		hexagonrpcd/*.c libhexagonrpc/*.c \
		-o hexagonrpcd-sweet
}

package() {
	install -Dm755 hexagonrpcd-sweet -t "$pkgdir/usr/libexec"
	install -Dm755 "$srcdir/hexagonrpcd-sweet-resume" \
		"$pkgdir/usr/lib/systemd/system-sleep/hexagonrpcd-sweet-resume"
	install -Dm644 "$srcdir/hexagonrpcd-sweet-resume.service" \
		"$pkgdir/usr/lib/systemd/system/hexagonrpcd-sweet-resume.service"
	install -Dm644 "$srcdir/hexagonrpcd-adsp-rootpd.conf" \
		"$pkgdir/usr/lib/systemd/system/hexagonrpcd-adsp-rootpd.service.d/90-sweet-static.conf"
	install -Dm644 "$srcdir/hexagonrpcd-adsp-sensorspd.conf" \
		"$pkgdir/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/90-sweet-static.conf"
	install -Dm644 "$srcdir/iio-sensor-proxy.conf" \
		"$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/90-sweet-ssc.conf"
}

