# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Based on Alpine community/iio-sensor-proxy 3.9-r2.
# Local SSC coldplug/early-claim fix, tested on Xiaomi sweet.
maintainer="mikoker <mikolaj.kolata@gmail.com>"
pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=3
pkgdesc="IIO sensors to D-Bus proxy"
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
arch="all"
license="GPL-3.0-or-later"
depends="dbus"
makedepends_build="meson glib-dev"
makedepends_host="
	eudev-dev
	glib-dev
	libgudev-dev
	polkit-dev
	libssc-dev
	"
options="pmb:cross-native2"
subpackages="$pkgname-openrc $pkgname-systemd $pkgname-udev $pkgname-dbg"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	iio-sensor-proxy.initd
	ssc-startup-claims.patch
	cross-polkit-policy-path.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dudevrulesdir=/usr/lib/udev/rules.d \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}

